{
  "_version": "1.86.0",

  "sap.app": {
    "id": "purchasemanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",

    "applicationVersion": {
      "version": "1.0.0"
    },

    "title": "{{appTitle}}",
    "description": "{{appDescription}}",

    "resources": "resources.json",

    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.31.1",
      "toolsId": "29c33ed5-2ca3-4a58-8600-2dc2796315ab"
    },

    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/purchase-order/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },

    "crossNavigation": {
      "inbounds": {
        "Purchase-display": {
          "semanticObject": "Purchase",
          "action": "display",
          "title": "{{Purchase-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },

  "sap.ui": {
    "technology": "UI5",

    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },

    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {
    "flexEnabled": true,

    "dependencies": {
      "minUI5Version": "1.152.0",

      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.tnt": {}
      }
    },

    "contentDensities": {
      "compact": true,
      "cozy": true
    },

    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",

        "settings": {
          "bundleName": "purchasemanagement.i18n.i18n"
        }
      },

      "purchase": {
        "dataSource": "mainService",
        "preload": true,

        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },

    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },

    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "purchasemanagement.view",
        "viewPath": "purchasemanagement.view",
        "async": true
      },

      "routes": [

        {
          "name": "Purchase",
          "pattern": "",
          "target": "Purchase"
        },

        {
          "name": "PurchaseOrders",
          "pattern": "purchase-orders",
          "target": "PurchaseOrders"
        },

        {
          "name": "CreatePurchaseOrder",
          "pattern": "create-po",
          "target": "CreatePurchaseOrder"
        },

        {
          "name": "PODetail",
          "pattern": "po/{ID}",
          "target": "PODetail"
        },

        {
          "name": "Products",
          "pattern": "products",
          "target": "Products"
        },

        {
          "name": "Warehouses",
          "pattern": "warehouses",
          "target": "Warehouses"
        },

        {
          "name": "Stock",
          "pattern": "stock",
          "target": "Stock"
        },

        {
          "name": "PriceMaster",
          "pattern": "price-master",
          "target": "PriceMaster"
        },

        {
          "name": "EditPurchaseOrder",
          "pattern": "purchase-orders/edit/{ID}",
          "target": "EditPurchaseOrder"
        },

        {
          "name": "PriceHistory",
          "pattern": "price-history",
          "target": "PriceHistory"
        },

        {
          "name": "Analytics",
          "pattern": "analytics",
          "target": "Analytics"
        }
      ],

      "targets": {

        "Purchase": {
          "id": "Purchase",
          "name": "Purchase"
        },

        "PurchaseOrders": {
          "id": "PurchaseOrders",
          "name": "PurchaseOrders"
        },

        "CreatePurchaseOrder": {
          "id": "CreatePurchaseOrder",
          "name": "CreatePurchaseOrder"
        },

        "PODetail": {
          "id": "PODetail",
          "name": "PODetail"
        },

        "Products": {
          "id": "Products",
          "name": "Products"
        },

        "Warehouses": {
          "id": "Warehouses",
          "name": "Warehouses"
        },

        "Stock": {
          "id": "Stock",
          "name": "Stock"
        },

        "PriceMaster": {
          "id": "PriceMaster",
          "name": "PriceMaster"
        },

        "EditPurchaseOrder": {
          "id": "EditPurchaseOrder",
          "name": "EditPurchaseOrder"
        },

        "PriceHistory": {
          "id": "PriceHistory",
          "name": "PriceHistory"
        },

        "Analytics": {
          "id": "Analytics",
          "name": "Analytics"
        }
      }
    },

    "rootView": {
      "viewName": "purchasemanagement.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },

  "sap.cloud": {
    "public": true,
    "service": "purchasemanagement"
  }
}