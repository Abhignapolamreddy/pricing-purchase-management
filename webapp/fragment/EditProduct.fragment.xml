<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="epDlg001"
        title="Edit Product"
        contentWidth="32rem"
        draggable="true"
        resizable="false">

        <content>
            <VBox id="epVbox001">

                <Label
                    id="epLblCode001"
                    text="Product Code"/>

                <Input
                    id="epInpCode001"
                    editable="false"
                    width="100%"/>

                <Label
                    id="epLblName001"
                    text="Product Name"
                    required="true"/>

                <Input
                    id="epInpName001"
                    placeholder="Enter product name"
                    width="100%"/>

                <Label
                    id="epLblCat001"
                    text="Category"
                    required="true"/>

                <Select
                    id="epSelCat001"
                    width="100%"
                    forceSelection="true"
                    items="{
                        path: 'purchase>/Categories',
                        filters: [
                            {
                                path: 'active',
                                operator: 'EQ',
                                value1: true
                            }
                        ],
                        sorter: {
                            path: 'categoryName',
                            descending: false
                        }
                    }">

                    <core:Item
                        id="epItemCat001"
                        key="{purchase>ID}"
                        text="{purchase>categoryName}"/>

                </Select>

                <Label
                    id="epLblPrice001"
                    text="Unit Price"
                    required="true"/>

                <Input
                    id="epInpPrice001"
                    type="Number"
                    placeholder="Enter unit price"
                    width="100%"/>

            </VBox>
        </content>

        <beginButton>
            <Button
                id="epBtnSave001"
                text="Save"
                type="Emphasized"
                press=".onEditProductConfirm"/>
        </beginButton>

        <endButton>
            <Button
                id="epBtnCancel001"
                text="Cancel"
                press=".onEditProductCancel"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>