<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="cpDlg001"
        title="Create Product"
        contentWidth="32rem"
        draggable="true"
        resizable="false">

        <content>
            <VBox id="cpVbox001">

                <Label
                    id="cpLblName001"
                    text="Product Name"
                    required="true"/>

                <Input
                    id="cpInpName001"
                    placeholder="Enter product name"
                    width="100%"/>

                <Label
                    id="cpLblCat001"
                    text="Category"
                    required="true"/>

                <Select
                    id="cpSelCat001"
                    width="100%"
                    forceSelection="true"
                    selectedKey=""
                    items="{
                        path: 'purchase>/Categories',
                        filters: [
                            {
                                path: 'active',
                                operator: 'EQ',
                                value1: true
                            }
                        ],
                        sorter: {
                            path: 'categoryName',
                            descending: false
                        }
                    }">

                    <core:Item
                        id="cpItemCat001"
                        key="{purchase>ID}"
                        text="{purchase>categoryName}"/>

                </Select>

                <Label
                    id="cpLblPrice001"
                    text="Unit Price"
                    required="true"/>

                <Input
                    id="cpInpPrice001"
                    type="Number"
                    placeholder="Enter unit price"
                    width="100%"/>

            </VBox>
        </content>

        <beginButton>
            <Button
                id="cpBtnCreate001"
                text="Create"
                type="Emphasized"
                press=".onCreateProductConfirm"/>
        </beginButton>

        <endButton>
            <Button
                id="cpBtnCancel001"
                text="Cancel"
                press=".onCreateProductCancel"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>