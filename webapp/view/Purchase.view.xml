<mvc:View
    id="purchaseView"
    controllerName="purchasemanagement.controller.Purchase"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    >

    <Page
        id="purchasePage"
        title="Home">

        <content>

            <VBox
                id="dashboardContainer"
                class="sapUiMediumMargin">

                <!-- Page Header -->
                <VBox
                    id="pageHeader"
                    class="sapUiSmallMarginBottom">

                    <Title
                        id="dashboardTitle"
                        text="Purchase Order Management"
                        level="H1" />

                    <Text
                        id="dashboardDescription"
                        text="Overview of purchase orders and purchasing activities"
                        class="sapUiTinyMarginTop" />

                </VBox>


                <!-- KPI Cards -->
                <l:Grid
                    id="kpiGrid"
                    defaultSpan="XL3 L3 M6 S12"
                    hSpacing="1"
                    vSpacing="1">

                    <!-- Total Purchase Orders -->
                    <GenericTile
                        id="totalPOTile"
                        header="Total Purchase Orders"
                        subheader="All purchase orders"
                        press=".onPurchaseOrders">

                        <TileContent
                            id="totalPOTileContent">

                            <NumericContent
                                id="totalPOValue"
                                value="{dashboard>/totalPOs}"
                                icon="sap-icon://sales-order"
                                valueColor="Neutral" />

                        </TileContent>

                    </GenericTile>


                    <!-- Pending -->
                    <GenericTile
                        id="pendingPOTile"
                        header="Pending Orders"
                        subheader="Pending approval"
                        press=".onPurchaseOrders">

                        <TileContent
                            id="pendingPOTileContent">

                            <NumericContent
                                id="pendingPOValue"
                                value="{dashboard>/pendingPOs}"
                                icon="sap-icon://pending"
                                valueColor="Critical" />

                        </TileContent>

                    </GenericTile>


                    <!-- Approved -->
                    <GenericTile
                        id="approvedPOTile"
                        header="Approved Orders"
                        subheader="Successfully approved"
                        press=".onPurchaseOrders">

                        <TileContent
                            id="approvedPOTileContent">

                            <NumericContent
                                id="approvedPOValue"
                                value="{dashboard>/approvedPOs}"
                                icon="sap-icon://accept"
                                valueColor="Good" />

                        </TileContent>

                    </GenericTile>


                    <!-- Purchase Value -->
                    <GenericTile
                        id="purchaseValueTile"
                        header="Purchase Value"
                        subheader="Total order value">

                        <TileContent
                            id="purchaseValueTileContent">

                            <NumericContent
                                id="purchaseValue"
                                value="{dashboard>/totalValue}"
                                scale="INR"
                                icon="sap-icon://money-bills"
                                valueColor="Neutral" />

                        </TileContent>

                    </GenericTile>

                </l:Grid>


                <!-- Main Dashboard Content -->
                <l:Grid
                    id="dashboardContentGrid"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapUiMediumMarginTop">


                    <!-- Purchase Order Status -->
                    <!-- <Panel
                        id="statusPanel"
                        headerText="Purchase Order Status"
