    <Panel id="idPnlChart" headerText="Regions"  >

        <viz:VizFrame id="idVizFrame" vizType="column" height="90%" width="100%" >
          <viz:dataset>

            <viz.data:FlattenedDataset
                id="idChartFlDataSet"
                data="{
                    path: 'purchase>/Regions',
                    parameters: { $select: 'ID,regionCode,regionName,totalPurchaseValue' }
                }">
              <viz.data:dimensions>
                <viz.data:DimensionDefinition id="idVizDataDmsnDef1" name="Region Code" value="{regionCode}" ></viz.data:DimensionDefinition>
                <viz.data:DimensionDefinition id="idVizDataDmsnDef2" name="Region" value="{regionName}" ></viz.data:DimensionDefinition>

              </viz.data:dimensions>

              <viz.data:measures>
                <viz.data:MeasureDefinition id="idVizDataMeasureDef" name="Purchase Value" value="{totalPurchaseValue}" ></viz.data:MeasureDefinition>
              </viz.data:measures>
            </viz.data:FlattenedDataset>
          
          </viz:dataset>

          <viz:feeds>

            <viz.feeds:FeedItem id="idVizFeedItmDM" uid="categoryAxis" type="Dimension" values="Region Code,Region" ></viz.feeds:FeedItem>
            <viz.feeds:FeedItem id="idVizFeedItmMS" uid="valueAxis" type="Measure" values="Purchase Value" ></viz.feeds:FeedItem> 
          </viz:feeds>

        </viz:VizFrame>
        <layoutData>
              <l:GridData id="idPnl4Lbl1Chart" span="L7 M7"></l:GridData>
        </layoutData>
      </Panel>


                    <!-- Quick Actions -->
                    <Panel
                        id="quickActionsPanel"
                        headerText="Quick Actions"
                        expandable="false"
                        >

                        <content>

                            <VBox
                                id="quickActionsContent"
                                class="sapUiSmallMargin">

                                <Button
                                    id="createPOButton"
                                    text="Create Purchase Order"
                                    icon="sap-icon://add-document"
                                    type="Emphasized"
                                    width="100%"
                                    press=".onCreatePO"
                                    class="sapUiTinyMarginBottom" />

                                <Button
                                    id="viewPOButton"
                                    text="View Purchase Orders"
                                    icon="sap-icon://sales-order"
                                    width="100%"
                                    press=".onPurchaseOrders"
                                    class="sapUiTinyMarginBottom" />

                                <Button
                                    id="productsButton"
                                    text="Products"
                                    icon="sap-icon://product"
                                    width="100%"
                                    press=".onProducts"
                                    class="sapUiTinyMarginBottom" />

                                <Button
                                    id="priceMasterButton"
                                    text="Price Master"
                                    icon="sap-icon://money-bills"
                                    width="100%"
                                    press=".onPriceMaster"
                                    class="sapUiTinyMarginBottom" />

                                <Button
                                    id="analyticsButton"
                                    text="Purchase Analytics"
                                    icon="sap-icon://business-objects-experience"
                                    width="100%"
                                    press=".onAnalytics" />

                            </VBox>

                        </content>
                        <layoutData>
                            <l:GridData id="idPnl4Lbl1QA" span="L5 M5"></l:GridData>
                        </layoutData>

                    </Panel>

                </l:Grid>


                <!-- Recent Purchase Orders -->
                <Panel
                    id="recentOrdersPanel"
                    headerText="Recent Purchase Orders"
                    class="sapUiMediumMarginTop">

                    <Table
                        id="recentOrdersTable"
                        growing="true"
                        growingThreshold="5"
                        items="{
                        path: 'purchase>/PurchaseOrders',
                        parameters: {
                            $orderby: 'createdAt desc',
                            $expand: 'dealer'
                        }
                    }">

                        <columns>

                            <Column
                                id="poNumberColumn">
                                <Text
                                    id="poNumberColumnText"
                                    text="PO Number" />
                            </Column>

                            <Column
                                id="dealerColumn">
                                <Text
                                    id="dealerColumnText"
                                    text="Dealer" />
                            </Column>

                            <Column
                                id="orderDateColumn">
                                <Text
                                    id="orderDateColumnText"
                                    text="Order Date" />
                            </Column>

                            <Column
                                id="amountColumn">
                                <Text
                                    id="amountColumnText"
                                    text="Amount" />
                            </Column>

                            <Column
                                id="statusColumn">
                                <Text
                                    id="statusColumnText"
                                    text="Status" />
                            </Column>

                        </columns>


                        <items>

                            <ColumnListItem
                                id="recentOrderItem"
                                type="Navigation"
                                press=".onPOPress">

                                <cells>

                                    <Text
                                        id="poNumberText"
                                        text="{purchase>poNumber}" />

                                    <Text
                                        id="dealerNameText"
                                        text="{purchase>dealer/dealerName}" />

                                    <Text
                                        id="orderDateText"
                                        text="{
                                            path: 'purchase>orderDate',
                                            formatter: '.formatter.formatDate'
                                        }" />

                                    <ObjectNumber
                                        id="amountText"
                                        number="{purchase>totalAmount}"
                                        unit="INR" />

                                    <ObjectStatus
                                        id="statusText"
                                        text="{purchase>status}"
                                        state="{
                                            path: 'purchase>status',
                                            formatter: '.formatter.statusState'
                                        }" />

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>