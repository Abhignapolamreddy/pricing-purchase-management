            </EntityType>
            <EntityType Name="PriceHistory">
                <Key>
                    <PropertyRef Name="ID"/>
                </Key>
                <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
                <NavigationProperty Name="priceMaster" Type="PricingService.PriceMaster" Partner="history">
                    <ReferentialConstraint Property="priceMaster_ID" ReferencedProperty="ID"/>
