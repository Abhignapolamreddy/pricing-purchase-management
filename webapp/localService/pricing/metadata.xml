            <ComplexType Name="return_PricingService_expirePrices">
                <Property Name="expiredCount" Type="Edm.Int32"/>
                <Property Name="message" Type="Edm.String"/>
            </ComplexType>
            <Action Name="recalculateFinalPrice" IsBound="false">
                <Parameter Name="ID" Type="Edm.Guid"/>
                <ReturnType Type="PricingService.return_PricingService_recalculateFinalPrice"/>
            </Action>
            <Action Name="expirePrices" IsBound="false">
                <ReturnType Type="PricingService.return_PricingService_expirePrices"/>
            </Action>
            <Function Name="getActivePriceCount" IsBound="false" IsComposable="false">
