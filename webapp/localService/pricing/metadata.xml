                <Collection>
                    <Record>
                        <PropertyValue Property="rel" String="author"/>
                        <PropertyValue Property="href" String="https://cap.cloud.sap"/>
                    </Record>
                </Collection>
            </Annotation>
            <EntityContainer Name="EntityContainer">
                <EntitySet Name="Products" EntityType="PricingService.Products">
                    <NavigationPropertyBinding Path="prices" Target="PriceMaster"/>
                </EntitySet>
                <EntitySet Name="PriceMaster" EntityType="PricingService.PriceMaster">
                    <NavigationPropertyBinding Path="region" Target="Regions"/>
                    <NavigationPropertyBinding Path="product" Target="Products"/>
                    <NavigationPropertyBinding Path="history" Target="PriceHistory"/>
                </EntitySet>
                <EntitySet Name="Regions" EntityType="PricingService.Regions"/>
                <EntitySet Name="PriceHistory" EntityType="PricingService.PriceHistory">
                    <NavigationPropertyBinding Path="priceMaster" Target="PriceMaster"/>
                </EntitySet>
                <EntitySet Name="PriceExpiryLog" EntityType="PricingService.PriceExpiryLog"/>
                <ActionImport Name="recalculateFinalPrice" Action="PricingService.recalculateFinalPrice"/>
                <ActionImport Name="expirePrices" Action="PricingService.expirePrices"/>
                <FunctionImport Name="getActivePriceCount" Function="PricingService.getActivePriceCount"/>
            </EntityContainer>
            <EntityType Name="Products">
                <Key>
                    <PropertyRef Name="ID"/>
                </Key>
                <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
                <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
                <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
                <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
                <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
                <Property Name="productCode" Type="Edm.String" MaxLength="20"/>
                <Property Name="productName" Type="Edm.String" MaxLength="100"/>
                <Property Name="category" Type="Edm.String" MaxLength="50"/>
                <Property Name="active" Type="Edm.Boolean" DefaultValue="true"/>
                <Property Name="unitPrice" Type="Edm.Decimal" Precision="15" Scale="2"/>
                <NavigationProperty Name="prices" Type="Collection(PricingService.PriceMaster)" Partner="product"/>
            </EntityType>
            <EntityType Name="PriceMaster">
                <Key>
                    <PropertyRef Name="ID"/>
                </Key>
                <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
                <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
                <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
                <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
                <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
                <Property Name="basePrice" Type="Edm.Decimal" Precision="15" Scale="2"/>
                <Property Name="discount" Type="Edm.Decimal" Precision="15" Scale="2" DefaultValue="0"/>
                <Property Name="tax" Type="Edm.Decimal" Precision="15" Scale="2" DefaultValue="0"/>
                <Property Name="finalPrice" Type="Edm.Decimal" Precision="15" Scale="2"/>
