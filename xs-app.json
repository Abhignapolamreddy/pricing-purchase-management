{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/purchase-order/(.*)$",
      "target": "/odata/v4/purchase-order/$1",
      "destination": "TAFE_CONN",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/odata/v4/analytics/(.*)$",
      "target": "/odata/v4/analytics/$1",
      "destination": "TAFE_CONN",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/odata/v4/dealer/(.*)$",
      "target": "/odata/v4/dealer/$1",
      "destination": "TAFE_CONN",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/inventory/(.*)$",
      "target": "/inventory/$1",
      "destination": "TAFE_CONN",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/pricing/(.*)$",
      "target": "/pricing/$1",
      "destination": "TAFE_CONN",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
